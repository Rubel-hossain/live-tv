# Playlist Configuration
PLAYLIST_FILE=Fifa world cup.m3u

# Application Configuration
NEXT_PUBLIC_APP_NAME=LiveTV
NEXT_PUBLIC_APP_VERSION=1.0.0

# Logging Configuration
# Options: debug, info, warn, error
NEXT_PUBLIC_LOG_LEVEL=info

# Performance Configuration
NEXT_PUBLIC_MAX_RECENT_CHANNELS=12
NEXT_PUBLIC_PLAYER_CHROME_HIDE_DELAY=2600
NEXT_PUBLIC_STREAM_PROXY_MODE=auto

# Feature Flags
NEXT_PUBLIC_ENABLE_FAVORITES=true
NEXT_PUBLIC_ENABLE_RECENTS=true
